# ─────────────────────────────────────────────────────────────────────────────
# LOCKIN environment template. Copy to `.env` and replace every CHANGE_ME value.
#   PowerShell:  Copy-Item .env.example .env
# Never commit `.env`. Generate strong passwords, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ── PostgreSQL (docker-compose.dev.yml) ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lockin
# Superuser — used ONLY by `pnpm db:bootstrap` to create the roles below.
POSTGRES_PASSWORD=CHANGE_ME_superuser_password
# Least-privilege roles (min 16 characters each).
DB_OWNER_PASSWORD=CHANGE_ME_owner_password_16+
DB_APP_PASSWORD=CHANGE_ME_app_password_16+__
DB_CMS_PASSWORD=CHANGE_ME_cms_password_16+__

DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME_superuser_password@localhost:5432/lockin
DATABASE_MIGRATION_URL=postgres://lockin_owner:CHANGE_ME_owner_password_16+@localhost:5432/lockin
DATABASE_URL=postgres://lockin_app:CHANGE_ME_app_password_16+__@localhost:5432/lockin
DATABASE_CMS_URL=postgres://lockin_cms:CHANGE_ME_cms_password_16+__@localhost:5432/lockin

# ── Object storage (MinIO) ───────────────────────────────────────────────────
MINIO_ROOT_USER=lockin-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# ── Email (Mailpit catches everything in development: http://localhost:8025) ─
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="LOCKIN <no-reply@lockin.home.arpa>"
